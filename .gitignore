# Build directories
build/
build_debug/
build.nosync/
bin/
bin_rel/
lib/
out/
dist/
CMakeFiles/
CPM_modules/
_deps/
msvc_*/
x64/
*.dir/
Release/
Debug/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/

# Local agent/build scratch
.codex
