/Class-Generation-From-Json-main/
/build_log.txt

# Output files (PolyFEM / Paraview; see end of file for experiment/ override)
*.vtu
*.vtm
*.pvd
*.csv
*.npz

# Ignore output contents but keep folder visible (track examples/output/.gitkeep)
examples/output/*
!examples/output/.gitkeep
examples/runs/
examples/classic_example/2D/2D_examples_outputs/

# Local solve dump at repo root only (avoid matching .../experiment/.../sim.json)
/sim.json
/impact_stats.json

# Slurm batch logs written at the repo root.
/slurm_logs/

# IDE
.vscode/*
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
.vs/
*.swp
*.swo
*~

# Dependencies (repo-root dirs only — avoids ignoring names like data_loader.py)
/3rdparty/
/data/
*libTracyClient.*

# Compiled binaries (Windows)
*.dll
*.pyd
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.a
# Note: nanobind.dll and TracyClient.dll in polyfempy/ are build artifacts

# Cache
.cache/
.env
env/
venv/
ENV/

# Temporary files
*.obj
*.log
*.tmp
*.bak
temp-plot.html
copy_lib
build_verbose.txt

# OS metadata
.DS_Store
Thumbs.db

# --- experiment/: nothing ignored except Python cache under it ---
# Overrides *.csv, *.npz, *.vtu, *.pvd, *.vtm, *.log, *.pyd, etc. for paths under experiment/
!experiment/
!experiment/**
experiment/**/__pycache__/
# Theta fine-sweep batch workspaces (PolyFEM case dirs + summaries); must appear after !experiment/**
experiment/new_experiment/theta_degree/theta_jump_fine_part1/
experiment/new_experiment/theta_degree/theta_jump_fine_part2/
experiment/new_experiment/theta_degree/theta_jump_fine_part3/

# Local experiment outputs and archived scratch trees. These rules must appear
# after !experiment/** so generated files under experiment/ stay local-only.
experiment/archive/
experiment/**/runs/
experiment/**/paper_runs/
experiment/**/slurm_logs/
experiment/**/outputs/
experiment/**/outputs_*/
experiment/**/result_summaries/
experiment/**/training_data/
experiment/**/training_data_*/
experiment/**/zip_parts/
