from collections.abc import Sequence
from typing import Annotated, overload

import numpy
from numpy.typing import NDArray


class PDEs:
    LinearElasticity: str = 'LinearElasticity'

    HookeLinearElasticity: str = 'HookeLinearElasticity'

    SaintVenant: str = 'SaintVenant'

    NeoHookean: str = 'NeoHookean'

    MooneyRivlin: str = 'MooneyRivlin'

    MooneyRivlin3Param: str = 'MooneyRivlin3Param'

    MooneyRivlin3ParamSymbolic: str = 'MooneyRivlin3ParamSymbolic'

    UnconstrainedOgden: str = 'UnconstrainedOgden'

    IncompressibleOgden: str = 'IncompressibleOgden'

    Stokes: str = 'Stokes'

    NavierStokes: str = 'NavierStokes'

    OperatorSplitting: str = 'OperatorSplitting'

    IncompressibleLinearElasticity: str = 'IncompressibleLinearElasticity'

    Laplacian: str = 'Laplacian'

    Helmholtz: str = 'Helmholtz'

    Bilaplacian: str = 'Bilaplacian'

    AMIPS: str = 'AMIPS'

    FixedCorotational: str = 'FixedCorotational'

def is_tensor(pde: str) -> bool: ...

class Solver:
    def __init__(self) -> None: ...

    def settings(self) -> str: ...

    def set_settings(self, json: object, strict_validation: bool = False) -> None: ...

    def set_max_threads(self, nthreads: int) -> None: ...

    def set_log_level(self, log_level: int) -> None: ...

    def load_mesh_from_settings(self) -> None: ...

    def set_mesh(self, vertices: Annotated[NDArray[numpy.float64], dict(shape=(None, None), order='F')], connectivity: Annotated[NDArray[numpy.int32], dict(shape=(None, None), order='F')], non_conforming: bool = False) -> None: ...

    def solve(self, log_level: int = 3) -> dict: ...

def polyfem_command(*, json: str, yaml: str = '', log_level: int = 1, strict_validation: bool = True, max_threads: int = 1, output_dir: str = '') -> None: ...

class Mesh:
    def dimension(self) -> int: ...

    def n_elements(self) -> int: ...

    def n_boundary_elements(self) -> int: ...

    def n_vertices(self) -> int: ...

    def n_cell_vertices(self, cell_id: int) -> int: ...

    def element_vertex(self, cell_id: int, local_vertex_id: int) -> int: ...

    def boundary_element_vertex(self, boundary_cell_id: int, local_vertex_id: int) -> int: ...

    def is_boundary_vertex(self, vertex_id: int) -> bool: ...

    def bounding_box(self) -> tuple: ...

    def set_boundary_ids(self, ids: Sequence[int]) -> None: ...

    def get_boundary_id(self, primitive: int) -> int: ...

    def get_body_ids(self) -> list[int]: ...

    def set_body_ids(self, ids: Sequence[int]) -> None: ...

    def point(self, vertex_id: int) -> Annotated[NDArray[numpy.float64], dict(shape=(None,), order='C')]: ...

    def set_point(self, vertex_id: int, position: Annotated[NDArray[numpy.float64], dict(shape=(None,), order='C')]) -> None: ...

    def vertices(self) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None), order='F')]: ...

    @overload
    def set_vertices(self, arg0: Annotated[NDArray[numpy.int32], dict(shape=(None,), order='C')], arg1: Annotated[NDArray[numpy.float64], dict(shape=(None, None), order='F')], /) -> None: ...

    @overload
    def set_vertices(self, arg: Annotated[NDArray[numpy.float64], dict(shape=(None, None), order='F')], /) -> None: ...

    def elements(self) -> Annotated[NDArray[numpy.int32], dict(shape=(None, None), order='F')]: ...

class Mesh2D(Mesh):
    pass

class Mesh3D(Mesh):
    pass

class DifferentiableSession:
    def __init__(self) -> None: ...

    def set_settings(self, settings: object) -> None: ...

    def settings(self) -> str: ...

    def set_objective(self, objective: object) -> None: ...

    def set_shape_vertices(self, vertices: object, *, selection: object | None = None) -> None: ...

    def set_material_lame_parameters(self, lame: object) -> None: ...

    def objective_info(self) -> object: ...

    def interior_vertex_ids(self, arg: Sequence[int], /) -> Annotated[NDArray[numpy.int32], dict(shape=(None,), order='C')]: ...

    def backward_dirichlet_shape(self, arg: object, /) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None), order='F')]: ...

    def set_shape_target(self, arg0: object, arg1: Sequence[int], arg2: Sequence[int], /) -> None: ...

    def set_target_settings(self, arg: object, /) -> None: ...

    def mesh_vertices(self) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None), order='F')]: ...

    def boundary_vertex_ids(self, ids: Sequence[int], exclude: bool = False) -> Annotated[NDArray[numpy.int32], dict(shape=(None,), order='C')]: ...

    def prepare_control(self, arg: object, /) -> int: ...

    def control_initial_parameters(self) -> Annotated[NDArray[numpy.float64], dict(shape=(None,), order='C')]: ...

    def set_control_parameters(self, arg: Annotated[NDArray[numpy.float64], dict(shape=(None,), order='C')], /) -> None: ...

    def solve_control_objective(self) -> float: ...

    def backward_control(self, arg: object, /) -> Annotated[NDArray[numpy.float64], dict(shape=(None,), order='C')]: ...

    def model_metadata(self) -> dict: ...

    def initial_condition_dof_count(self) -> int: ...

    def initial_condition_parameters(self) -> Annotated[NDArray[numpy.float64], dict(shape=(None,), order='C')]: ...

    def set_initial_condition_parameters(self, initial_condition: object) -> None: ...

    def solve(self) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None), order='F')]: ...

    def solve_objective(self) -> float: ...

    def solve_material_objective(self) -> float: ...

    def solve_initial_condition_objective(self) -> float: ...

    def backward_shape(self, grad_u: object) -> Annotated[NDArray[numpy.float64], dict(shape=(None, None), order='F')]: ...

    def backward_material(self, grad_u: object) -> Annotated[NDArray[numpy.float64], dict(shape=(None,), order='C')]: ...

    def backward_initial_condition(self, grad_u: object) -> Annotated[NDArray[numpy.float64], dict(shape=(None,), order='C')]: ...

def version() -> str: ...
