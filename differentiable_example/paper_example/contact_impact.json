  "time": {
    "t0": 0.0,
    "tend": 0.02,
    "dt": 0.01,
    "integrator": "ImplicitEuler"
  },
  "output": {
    "directory": "../runs/readme_contact_impact",
    "json": "impact_stats.json",
    "paraview": {
      "volume": true,
      "surface": false,
      "wireframe": false,
      "points": false,
      "high_order_mesh": true,
      "file_name": "",
      "options": {
        "material": true,
        "body_ids": true,
        "velocity": true,
        "scalar_values": true,
        "tensor_values": true
      },
      "vismesh_rel_area": 10000000,
      "skip_frame": 1
